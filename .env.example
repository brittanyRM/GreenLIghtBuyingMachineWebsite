# ---- GoHighLevel webhooks (server-side only) ----
GHL_APPLICATION_WEBHOOK_URL=
GHL_PROPERTY_WEBHOOK_URL=
GHL_PREQUAL_WEBHOOK_URL=
GHL_BOOK_WAITLIST_WEBHOOK_URL=
GHL_WEBINAR_WEBHOOK_URL=

# ---- Admin editor at /admin ----
# The password Brian and Gina type in. Pick something long.
ADMIN_PASSWORD=
# Any long random string. Signs the login cookie. Changing it logs everyone out.
ADMIN_SECRET=
# Where content is committed. Format: owner/repo
GITHUB_REPO=
# Fine-grained personal access token with Contents: Read and write on that repo only.
GITHUB_TOKEN=
# Optional, defaults to main
GITHUB_BRANCH=main
